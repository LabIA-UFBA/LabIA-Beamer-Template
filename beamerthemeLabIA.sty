\ProvidesPackage{beamerthemeLabIA}[2026/02/01]

\RequirePackage{graphicx}
\RequirePackage{tikz}
\RequirePackage{etoolbox}
\RequirePackage{ifxetex}
\RequirePackage[svgnames]{xcolor}
\RequirePackage{xparse}
\usetikzlibrary{calc}


% ===== Opções =====

% A numeração da página deve aparecer na página de título (padrão: false)
\newbool{@titlepagenumber}
\setbool{@titlepagenumber}{false}

% As páginas devem ser numeradas (padrão: true)
\newbool{@pagenumber}
\setbool{@pagenumber}{true}

% Usa o tema branco para a barra lateral e o fundo
% dos slides de título e cabeçalho de seção (padrão: false)
\newbool{@white}
\setbool{@white}{false}

\DeclareOptionBeamer{titlepagenumber}{\setbool{@titlepagenumber}{true}}
\DeclareOptionBeamer{nopagenumber}{\setbool{@pagenumber}{false}}
\DeclareOptionBeamer{white}{\setbool{@white}{true}}
\ProcessOptionsBeamer


% ===== Definições =====

\setbeamertemplate{navigation symbols}{}
\newlength{\@sidebarwidth}
\setlength{\@sidebarwidth}{15mm}
\newcommand{\@sidebarimage}{\ifbool{@white}{logo_white.pdf}{logo.pdf}}
\newcommand{\@fmtpage}[2]{\makebox[1.5em][#1]{#2}}
\definecolor{LabIAblue}{RGB}{62,81,149}
\colorlet{primary}{\ifbool{@white}{white}{LabIAblue}}
\colorlet{secondary}{\ifbool{@white}{LabIAblue}{white}}


% ===== Barra lateral =====

\setbeamertemplate{background}{
\begin{tikzpicture}[remember picture,overlay]
    \fill[primary] % Barra lateral
        ($(current page.north east)+(-\@sidebarwidth,0)$)
        rectangle
        (current page.south east);

    \draw[secondary, line width=0.5mm] % Linha central da barra lateral
        ($(current page.north east)+(-0.5*\@sidebarwidth,-23mm)$)
        --
        ($(current page.south east)+(-0.5*\@sidebarwidth,2mm)$);
    
    \node[anchor=north east, inner sep=0, xshift=-0.5mm, yshift=-1mm] % Logo do LabIA
        at (current page.north east)
        {\includegraphics[width=\dimexpr\@sidebarwidth-1mm\relax]{\@sidebarimage}};
    
    \ifboolexpr{ % Numeração de página
        bool {@pagenumber}
        and
        ( bool {@titlepagenumber}
        or
        test {\ifnumcomp{\value{page}}{>}{1}} )
    }{
        \node[
            anchor=south,
            text=secondary,
            fill=primary,
            inner ysep=2mm,
            font=\small
        ] at ($(current page.south east)+(-0.5*\@sidebarwidth,0)$)
        {\@fmtpage{r}{\insertframenumber}/\@fmtpage{l}{\inserttotalframenumber}};
    }{}
\end{tikzpicture}
}

% Ajustar conteúdo com a barra lateral (apenas em slides não-titlepage)
\setbeamersize{
    text margin right=\dimexpr\@sidebarwidth+0.5cm\relax,
    text margin left=7mm
}


% ===== Página de título =====

\def\ps@nav@titlepage{
    \setbeamercolor{background canvas}{bg=primary}
    \@nameuse{ps@nav}
}
\setbeamertemplate{title page}{
    \thispagestyle{nav@titlepage}

    \begingroup

    % Cores das fontes
    \setbeamercolor{title}{fg=secondary}
    \setbeamercolor{subtitle}{fg=secondary}
    \setbeamercolor{author}{fg=secondary}
    \setbeamercolor{institute}{fg=secondary}
    \setbeamercolor{date}{fg=secondary}

    % Tamanho das fontes
    \setbeamerfont{title}{size=\LARGE,series=\bfseries}
    \setbeamerfont{subtitle}{size=\large,series=\mdseries}
    \setbeamerfont{author}{size=\normalsize}
    \setbeamerfont{institute}{size=\footnotesize}
    \setbeamerfont{date}{size=\footnotesize}

    % Layout da página
    \begin{center}
        %\settitlepage
        \hspace*{\dimexpr(\@sidebarwidth+0.5cm)/2\relax}%
        \begin{minipage}[c][0.9\paperheight]{0.75\paperwidth}
            \centering
            % TÍTULO
            {\usebeamerfont{title}%
            \usebeamercolor[fg]{title}%
            \inserttitle\par}
            
            % SUBTÍTULO (se existir)
            \ifx\insertsubtitle\@empty\else
                \vspace{1em}
                {\usebeamerfont{subtitle}%
                \usebeamercolor[fg]{subtitle}%
                \insertsubtitle\par}
            \fi
            
            % ESPAÇO ANTES DA LINHA
            \vspace{1.5em}
            
            % LINHA HORIZONTAL
            \begin{tikzpicture}
            \draw[secondary,line width=1mm]
                (0,0) -- (0.2\paperwidth,0);
            \end{tikzpicture}
            
            \vspace{1.5em}
            
            % AUTOR (se existir)
            \ifx\insertauthor\@empty\else
                {\usebeamerfont{author}%
                \usebeamercolor[fg]{author}%
                \insertauthor\par}
            \fi
            
            % INSTITUTO (se existir)
            \ifx\insertinstitute\@empty\else
                \vspace{1em}
                {\usebeamerfont{institute}%
                \usebeamercolor[fg]{institute}%
                \insertinstitute\par}
            \fi
            
            % DATA (se existir)
            \ifx\insertdate\@empty\else
                \vspace{1em}
                {\usebeamerfont{date}%
                \usebeamercolor[fg]{date}%
                \insertdate\par}
            \fi
        \end{minipage}
    \end{center}

    \endgroup
}


% ===== Cabeçalho de seção =====

\NewDocumentCommand{\framesection}{g g}{%
    \IfNoValueTF{#1} {%
        \def\framesectiontitle{\insertsection}%
    }{%
        \IfBlankTF{#1}
            {\def\framesectiontitle{\insertsection}}
            {\def\framesectiontitle{#1}}%
    }%
    %
    \IfNoValueTF{#2}
        {\def\framesectionsubtitle{}}
        {\def\framesectionsubtitle{#2}}%
    %
    {%
        \setbeamercolor{background canvas}{bg=primary}
        \setbeamercolor{title}{fg=secondary}
        \setbeamerfont{title}{size=\LARGE}
        \setbeamerfont{subtitle}{size=\large}
        
        \begin{frame}
            %\settitlepage
            \begin{center}
                \hspace*{\dimexpr(\@sidebarwidth+0.5cm)/2\relax}%
                \begin{minipage}[c][0.9\paperheight]{0.75\paperwidth}
                    \centering
                    
                    % Título da seção
                    {\usebeamerfont{title}%
                    \usebeamercolor[fg]{title}%
                    \textbf{\framesectiontitle}\par}

                    % Subtítulo da seção
                    \ifx\framesectionsubtitle\@empty
                    \else
                    {\vspace{1em}\usebeamerfont{subtitle}%
                    \usebeamercolor[fg]{title}%
                    \framesectionsubtitle\par}
                    \fi
                \end{minipage}
            \end{center}
        \end{frame}%
    }
}


% ===== Título e subtítulo das páginas =====

\setbeamerfont{frametitle}{
  series=\bfseries
}

\setbeamercolor{frametitle}{
  fg=LabIAblue
}

\setbeamerfont{framesubtitle}{
  series=\mdseries
}

\setbeamercolor{framesubtitle}{
  fg=LabIAblue
}

\setbeamertemplate{frametitle}{
    \vspace*{4mm}%
    {\usebeamerfont{frametitle}%
     \usebeamercolor[fg]{frametitle}%
     \insertframetitle\par}
    
    \ifx\insertframesubtitle\@empty\else
        \vspace{0.2em}
        {\usebeamerfont{framesubtitle}%
         \usebeamercolor[fg]{framesubtitle}%
         \insertframesubtitle\par}
    \fi
}


% ===== itemize, enumerate, description, tableofcontents e nome das legendas =====

% itemize
\setbeamertemplate{itemize item}{\Large$\bullet$}
\setbeamertemplate{itemize subitem}{\large$\circ$}
\setbeamertemplate{itemize subsubitem}{\tiny$\blacksquare$}
\setbeamercolor{itemize item}{fg=LabIAblue}
\setbeamercolor{itemize subitem}{fg=LabIAblue}
\setbeamercolor{itemize subsubitem}{fg=LabIAblue}

% enumerate
\setbeamercolor{enumerate item}{fg=LabIAblue}
\setbeamercolor{enumerate subitem}{fg=LabIAblue}
\setbeamercolor{enumerate subsubitem}{fg=LabIAblue}

% description
\setbeamercolor{description item}{fg=LabIAblue}

% tableofcontents
\setbeamercolor{section in toc}{fg=LabIAblue}

% Nome das legendas
\setbeamercolor{caption name}{fg=LabIAblue}


% ===== Links =====
\hypersetup{
    colorlinks=true,
    linkcolor=.,
    urlcolor=LabIAblue
}


% ===== Blocos =====

\newcommand{\@configblock}[2][]{
    \setbeamerfont{block title#1}{series=\bfseries}
    \setbeamercolor{block title#1}{fg=white,bg=#2}
    \setbeamercolor{block body#1}{fg=black,bg=#2!20}
}
\@configblock{LabIAblue}
\@configblock[ alerted]{FireBrick}
\@configblock[ example]{Green}


% ===== Botões =====

\setbeamercolor{button}{fg=white,bg=LabIAblue}


% ===== Definição das fontes =====

\newcommand{\@setfont}{
    \RequirePackage{fontspec}
    \IfFontExistsTF{Arial}{
        \setmainfont{Arial}
        \setsansfont{Arial}
    }{
        \IfFontExistsTF{Liberation Sans}{
            \setmainfont{Liberation Sans}
            \setsansfont{Liberation Sans}
        }{
            \renewcommand{\familydefault}{phv}
        }
    }
}

\ifxetex
    \@setfont
\else
    \RequirePackage{ifluatex}
    \ifLuaTeX
        \@setfont
    \else
        \RequirePackage[utf8]{inputenc}
        \RequirePackage[T1]{fontenc}
        \renewcommand{\familydefault}{phv}
    \fi
\fi